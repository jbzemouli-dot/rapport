\providecommand\hyper@newdestlabel[2]{}
\newlabel{acronyms}{{}{15}{Acronymes}{section*.8}{}}
\@writefile{toc}{\contentsline {chapter}{\textmd  {Acronymes}}{15}{section*.8}\protected@file@percent }
\newacro{ANTEX}[\AC@hyperlink{ANTEX}{ANTEX}]{ANTenna EXchange format, format des calibrations d'antennes GNSS}
\newacro{API}[\AC@hyperlink{API}{API}]{Application Programming Interface, interface de programmation}
\newacro{ARP}[\AC@hyperlink{ARP}{ARP}]{Antenna Reference Point, point de référence physique d'une antenne}
\newacro{BEIDOU}[\AC@hyperlink{BEIDOU}{BEIDOU}]{Système chinois de navigation par satellites}
\newacro{BGD}[\AC@hyperlink{BGD}{BGD}]{Broadcast Group Delay, biais de groupe diffusé par GALILEO}
\newacro{BIA}[\AC@hyperlink{BIA}{BIA}]{Produit de biais précis fourni par l'IGS}
\newacro{CDF}[\AC@hyperlink{CDF}{CDF}]{Cumulative Distribution Function, fonction de répartition cumulée}
\newacro{CDDIS}[\AC@hyperlink{CDDIS}{CDDIS}]{Crustal Dynamics Data Information System, centre d'archive de données de géodésie spatiale de la NASA}
\newacro{CDMA}[\AC@hyperlink{CDMA}{CDMA}]{Code Division Multiple Access, accès multiple par répartition en code}
\newacro{CLK}[\AC@hyperlink{CLK}{CLK}]{Produit d'horloges précises fourni par l'IGS}
\newacro{CNES}[\AC@hyperlink{CNES}{CNES}]{Centre national d'études spatiales}
\newacro{CSV}[\AC@hyperlink{CSV}{CSV}]{Comma-Separated Values, format de données tabulaires}
\newacro{DOP}[\AC@hyperlink{DOP}{DOP}]{Dilution Of Precision, indicateur de dégradation géométrique de la précision}
\newacro{DOY}[\AC@hyperlink{DOY}{DOY}]{Day Of Year, numéro du jour dans l'année}
\newacro{ECEF}[\AC@hyperlink{ECEF}{ECEF}]{Earth-Centered, Earth-Fixed, repère cartésien lié à la Terre}
\newacro{EKF}[\AC@hyperlink{EKF}{EKF}]{Extended Kalman Filter, filtre de Kalman étendu}
\newacro{ENAC}[\AC@hyperlink{ENAC}{ENAC}]{École nationale de l'aviation civile}
\newacro{ENU}[\AC@hyperlink{ENU}{ENU}]{East, North, Up, repère local Est, Nord, Haut}
\newacro{ESA}[\AC@hyperlink{ESA}{ESA}]{European Space Agency, Agence spatiale européenne}
\newacro{FDNAV}[\AC@hyperlink{FDNAV}{FD NAV}]{Flight Dynamics and Navigation, équipe de dynamique du vol et de navigation}
\newacro{GAL}[\AC@hyperlink{GAL}{GAL}]{Abréviation de GALILEO employée dans les configurations et les figures}
\newacro{GALILEO}[\AC@hyperlink{GALILEO}{GALILEO}]{Système européen de navigation par satellites}
\newacro{GCRF}[\AC@hyperlink{GCRF}{GCRF}]{Geocentric Celestial Reference Frame, repère céleste géocentrique}
\newacro{GDOP}[\AC@hyperlink{GDOP}{GDOP}]{Geometric Dilution Of Precision, DOP portant sur la position et l'horloge}
\newacro{GF}[\AC@hyperlink{GF}{GF}]{Geometry-Free, combinaison d'observations sans terme géométrique}
\newacro{GGTO}[\AC@hyperlink{GGTO}{GGTO}]{GALILEO-to-GPS Time Offset, décalage entre les échelles de temps GALILEO et GPS}
\newacro{GLONASS}[\AC@hyperlink{GLONASS}{GLONASS}]{Global Navigation Satellite System, système russe de navigation par satellites}
\newacro{GNSS}[\AC@hyperlink{GNSS}{GNSS}]{Global Navigation Satellite System, système mondial de navigation par satellites}
\newacro{GPS}[\AC@hyperlink{GPS}{GPS}]{Global Positioning System, système américain de navigation par satellites}
\newacro{HDOP}[\AC@hyperlink{HDOP}{HDOP}]{Horizontal Dilution Of Precision, DOP de la position horizontale}
\newacro{IERS}[\AC@hyperlink{IERS}{IERS}]{International Earth Rotation and Reference Systems Service, service international de la rotation terrestre et des systèmes de référence}
\newacro{IF}[\AC@hyperlink{IF}{IF}]{Ionosphere-Free, combinaison d'observations qui élimine l'effet ionosphérique du premier ordre}
\newacro{IGS}[\AC@hyperlink{IGS}{IGS}]{International GNSS Service, service international fournissant des produits GNSS de référence}
\newacro{IPP}[\AC@hyperlink{IPP}{IPP}]{Ionospheric Pierce Point, point d'intersection du signal avec la couche ionosphérique modélisée}
\newacro{IRNSS}[\AC@hyperlink{IRNSS}{IRNSS}]{Indian Regional Navigation Satellite System, système régional indien de navigation par satellites}
\newacro{ISB}[\AC@hyperlink{ISB}{ISB}]{Inter-System Bias, biais entre deux constellations}
\newacro{ITRF}[\AC@hyperlink{ITRF}{ITRF}]{International Terrestrial Reference Frame, réalisation internationale du repère terrestre}
\newacro{JSON}[\AC@hyperlink{JSON}{JSON}]{JavaScript Object Notation, format textuel d'échange de données}
\newacro{KLO}[\AC@hyperlink{KLO}{KLO}]{Abréviation du modèle ionosphérique de Klobuchar dans les configurations}
\newacro{LLI}[\AC@hyperlink{LLI}{LLI}]{Loss-of-Lock Indicator, indicateur de perte de verrouillage du signal}
\newacro{MW}[\AC@hyperlink{MW}{MW}]{Melbourne-Wübbena, combinaison d'observations utilisée pour détecter les sauts de cycle}
\newacro{NAV}[\AC@hyperlink{NAV}{NAV}]{Navigation, désignation des éphémérides diffusées dans les configurations}
\newacro{NMF}[\AC@hyperlink{NMF}{NMF}]{Niell Mapping Function, fonction de projection du retard troposphérique}
\newacro{NTRIP}[\AC@hyperlink{NTRIP}{NTRIP}]{Networked Transport of RTCM via Internet Protocol, diffusion de données GNSS par Internet}
\newacro{ORBEX}[\AC@hyperlink{ORBEX}{ORBEX}]{ORBit EXchange format, format d'échange de données d'orbite et d'attitude}
\newacro{PC}[\AC@hyperlink{PC}{PC}]{Phase Center, centre de phase électromagnétique d'une antenne}
\newacro{PCO}[\AC@hyperlink{PCO}{PCO}]{Phase Center Offset, décalage du centre de phase d'une antenne}
\newacro{PCV}[\AC@hyperlink{PCV}{PCV}]{Phase Center Variation, variation du centre de phase d'une antenne}
\newacro{PDOP}[\AC@hyperlink{PDOP}{PDOP}]{Position Dilution Of Precision, DOP de la position tridimensionnelle}
\newacro{POD}[\AC@hyperlink{POD}{POD}]{Precise Orbit Determination, détermination précise d'orbite}
\newacro{PPP}[\AC@hyperlink{PPP}{PPP}]{Precise Point Positioning, positionnement ponctuel précis}
\newacro{PRN}[\AC@hyperlink{PRN}{PRN}]{Pseudo-Random Noise, code pseudo-aléatoire identifiant un satellite}
\newacro{PVT}[\AC@hyperlink{PVT}{PVT}]{Position, Velocity and Time, position, vitesse et temps}
\newacro{QZSS}[\AC@hyperlink{QZSS}{QZSS}]{Quasi-Zenith Satellite System, système régional japonais de navigation par satellites}
\newacro{RINEX}[\AC@hyperlink{RINEX}{RINEX}]{Receiver INdependent EXchange Format, format d'échange indépendant du récepteur}
\newacro{RMSE}[\AC@hyperlink{RMSE}{RMSE}]{Root Mean Square Error, erreur quadratique moyenne}
\newacro{RTCM}[\AC@hyperlink{RTCM}{RTCM}]{Radio Technical Commission for Maritime Services, organisme à l'origine de formats de données GNSS temps réel}
\newacro{RTKLIB}[\AC@hyperlink{RTKLIB}{RTKLIB}]{Real-Time Kinematic Library, logiciel libre de traitement GNSS}
\newacro{SAAS}[\AC@hyperlink{SAAS}{SAAS}]{Abréviation du modèle troposphérique de Saastamoinen dans les configurations}
\newacro{SBAS}[\AC@hyperlink{SBAS}{SBAS}]{Satellite-Based Augmentation System, système d'augmentation satellitaire}
\newacro{SINEX}[\AC@hyperlink{SINEX}{SINEX}]{Solution INdependent EXchange Format, format d'échange de solutions géodésiques}
\newacro{SNR}[\AC@hyperlink{SNR}{SNR}]{Signal-to-Noise Ratio, rapport signal sur bruit}
\newacro{SP3}[\AC@hyperlink{SP3}{SP3}]{Standard Product 3, format d'éphémérides précises}
\newacro{SPP}[\AC@hyperlink{SPP}{SPP}]{Single Point Positioning, positionnement ponctuel standard}
\newacro{SSR}[\AC@hyperlink{SSR}{SSR}]{State Space Representation, représentation des corrections dans l'espace d'état}
\newacro{STEC}[\AC@hyperlink{STEC}{STEC}]{Slant Total Electron Content, contenu électronique total sur le trajet du signal}
\newacro{TDOP}[\AC@hyperlink{TDOP}{TDOP}]{Time Dilution Of Precision, DOP du biais d'horloge}
\newacro{TGD}[\AC@hyperlink{TGD}{TGD}]{Total Group Delay, biais de groupe diffusé par GPS}
\newacro{TLSG}[\AC@hyperlink{TLSG}{TLSG}]{Identifiant de la station GNSS de Toulouse utilisée dans les essais}
\newacro{TRO}[\AC@hyperlink{TRO}{.TRO}]{Produit IGS contenant des paramètres troposphériques de référence}
\newacro{UTC}[\AC@hyperlink{UTC}{UTC}]{Coordinated Universal Time, temps universel coordonné}
\newacro{VDOP}[\AC@hyperlink{VDOP}{VDOP}]{Vertical Dilution Of Precision, DOP de la position verticale}
\newacro{WLS}[\AC@hyperlink{WLS}{WLS}]{Weighted Least Squares, moindres carrés pondérés}
\newacro{YEBE}[\AC@hyperlink{YEBE}{YEBE}]{Identifiant de la station GNSS de Yebes utilisée dans les essais}
\newacro{ZHD}[\AC@hyperlink{ZHD}{ZHD}]{Zenith Hydrostatic Delay, retard troposphérique hydrostatique au zénith}
\newacro{ZTD}[\AC@hyperlink{ZTD}{ZTD}]{Zenith Total Delay, retard troposphérique total au zénith}
\newacro{ZWD}[\AC@hyperlink{ZWD}{ZWD}]{Zenith Wet Delay, retard troposphérique humide au zénith}
